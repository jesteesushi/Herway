# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-scripts

# Production Geocoding & Basemap (MapTiler)
# Free tier key from https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=your-maptiler-api-key

# Initial Moderator Bootstrap
# Secret token required to claim the first moderator account on a new instance
MODERATOR_BOOTSTRAP_TOKEN=your-secure-bootstrap-token-min-8-chars
